generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id           String        @id
  title        String
  tagline      String
  genre        String
  duration     Int
  ageRating    String
  startsAt     DateTime      @db.Timestamptz(3)
  hall         String
  artwork      String
  price        Int
  seats        EventSeat[]
  reservations Reservation[]
}

model EventSeat {
  eventId              String
  seatId               String
  currentReservationId String?       @unique @db.Uuid
  event                Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  currentReservation   Reservation?  @relation("CurrentOwner", fields: [currentReservationId], references: [id], onDelete: Restrict)
  reservations         Reservation[] @relation("SeatHistory")
  @@id([eventId, seatId])
}

model Reservation {
  id           String    @id @db.Uuid
  eventId      String
  seatId       String
  customerName String
  email        String
  fingerprint  String
  amount       Int
  pointsUsed   Int       @default(0)
  pointsEarned Int       @default(0)
  loyaltyStatus String   @default("none")
  createdAt    DateTime  @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seat         EventSeat @relation("SeatHistory", fields: [eventId, seatId], references: [eventId, seatId], onDelete: Restrict)
  ownedSeat    EventSeat? @relation("CurrentOwner")
  ticket       Ticket?
  payments     PaymentAttempt[]
  @@unique([id, eventId, seatId])
  @@index([eventId, seatId, expiresAt])
}

model Ticket {
  id            String      @id @db.Uuid
  reservationId String      @unique @db.Uuid
  eventId       String
  seatId        String
  code          String      @unique
  purchasedAt   DateTime    @db.Timestamptz(3)
  reservation   Reservation @relation(fields: [reservationId, eventId, seatId], references: [id, eventId, seatId], onDelete: Restrict)
  @@unique([reservationId, eventId, seatId])
  @@unique([eventId, seatId])
}

model RateLimit {
  key       String   @id
  attempts  Int
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

model PaymentAttempt {
  id              String      @id @db.Uuid
  reservationId   String      @db.Uuid
  generation      Int
  request         Json
  sessionId       String?     @unique
  paymentIntentId String?     @unique
  url             String?
  state           String      @default("creating")
  refundId        String?     @unique
  refundStatus    String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  pointsUsed      Int         @default(0)
  pointsState     String      @default("none")
  loyaltyEnabled  Boolean     @default(false)
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  @@unique([reservationId, generation])
}

model StripeEvent {
  id          String   @id
  processedAt DateTime @default(now()) @db.Timestamptz(3)
}

// Identifiers only: the balance is always read from Voucherify.
model LoyaltyAccount {
  email           String   @id
  memberId        String?  @unique
  state           String   @default("new")
  welcomeRequired Boolean  @default(false)
}

model LoyaltyOperation {
  id        String   @id
  email     String
  points    Int
  state     String   @default("pending")
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([email, state])
}

model Delivery {
  reservationId String   @id @db.Uuid
  providerId    String?  @unique
  state         String   @default("pending")
  request       Json?
  firstSentAt   DateTime? @db.Timestamptz(3)
  lastEventAt   DateTime? @db.Timestamptz(3)
}

model DeliveryEvent {
  id         String   @id
  providerId String
  state      String
  occurredAt DateTime @db.Timestamptz(3)
  @@index([providerId])
}

model WorkItem {
  id          String   @id
  kind        String
  targetId    String   @db.Uuid
  state       String   @default("pending")
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil  DateTime? @db.Timestamptz(3)
  token       String?
  lastError   String?
  @@index([state, availableAt])
}
