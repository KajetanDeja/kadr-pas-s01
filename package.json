{
  "name": "kadr-pas-s01", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "prisma generate && tsx --test tests/unit.test.ts",
    "test:api": "tsx scripts/run-tests.ts api",
    "test:120": "tsx scripts/run-tests.ts ttl120"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1", "@prisma/client": "7.10.1",
    "next": "16.4.3", "pg": "^8.16.3", "react": "19.3.1", "react-dom": "19.3.1", "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3", "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.3", "prisma": "7.10.1", "tailwindcss": "4.3.3", "tsx": "^4.20.6", "typescript": "^5.9.3"
  }
}
