POSTGRES_USER=kadr
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=kadr
DATABASE_URL=postgresql://kadr:replace-with-local-password@127.0.0.1:54320/kadr
TEST_DATABASE_URL=postgresql://kadr:replace-with-local-password@127.0.0.1:54321/kadr_test
RESERVATION_TTL_SECONDS=900

# Vercel: integracja ustawia DATABASE_URL (direct) i DATABASE_URL_POOLED (pooler).
# Aplikacja preferuje pooler, a CLI/migracje i seed używają DATABASE_URL.
# Lokalnie nie trzeba ustawiać DATABASE_URL_POOLED.
# DATABASE_URL_POOLED=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
# TTL na sprawdzanie: RESERVATION_TTL_SECONDS=120.
# Nie kopiuj tam lokalnych POSTGRES_* ani TEST_DATABASE_URL.
# Systemowe VERCEL / VERCEL_ENV dostarcza platforma; nie ustawiaj ich lokalnie.
# Opcjonalnie tylko dla własnego Nginx (minimum 32 znaki, na Vercel zbędne):
# TRUSTED_PROXY_SECRET=

